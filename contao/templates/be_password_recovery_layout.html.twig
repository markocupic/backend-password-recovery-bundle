<!DOCTYPE html>
<html lang="{{ language }}">
<head>
    {% block head %}
        <meta charset="{{ charset }}">
        <title>Contao | {{ host }}</title>

        {% block meta %}
            <meta name="generator" content="Contao Open Source CMS">
            <meta name="viewport" content="width=device-width,initial-scale=1.0,shrink-to-fit=no">
            <meta name="referrer" content="origin">
            <meta name="robots" content="noindex,follow">
        {% endblock %}

        {# Contao 5.3 ships the stylesheet with the back end theme, Contao 6 with the core bundle #}
        <link rel="stylesheet" href="{{ asset('login.css', theme ? 'system/themes/' ~ theme : 'contao_core') }}">
        <link rel="stylesheet" href="{{ asset('bundles/markocupicbackendpasswordrecovery/stylesheet.min.css') }}">
    {% endblock %}
</head>
<body class="be_login">

{% block container %}
    <div id="container" class="backend-password-recovery">
        <main id="main">
            {% block main %}{% endblock %}
        </main>
        {{ messages|raw }}
    </div>
{% endblock %}

</body>
</html>
