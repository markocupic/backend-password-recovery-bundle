{% extends '@Contao/be_password_recovery_layout.html.twig' %}
{% trans_default_domain 'contao_default' %}

{% block main %}
    <form class="tl_require_password_link_form" method="post">
        <div class="formbody">
            <input type="hidden" name="FORM_SUBMIT" value="tl_require_password_link_form">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
            <h1>{{ 'MSC.pwRecoveryHeadline'|trans }}</h1>
            <div class="widget widget-text">
                <label for="usernameOrEmail">{{ 'MSC.usernameOrEmailExplain'|trans }}</label>
                <input type="text" name="usernameOrEmail" id="usernameOrEmail" class="tl_text" value="" placeholder="{{ 'MSC.usernameOrEmailPlaceholder'|trans }}" required>
            </div>
            <div class="submit_container cf">
                <button type="submit" name="recoverPasswordRequest" id="recoverPasswordRequest" class="tl_submit button-primary">{{ 'MSC.continue'|trans }}</button>
                <a href="{{ backHref }}" class="tl_submit btn-link ms-1">{{ 'MSC.backBT'|trans }}</a>
            </div>
        </div>
    </form>
{% endblock %}
