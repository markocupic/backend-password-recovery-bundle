{
    "name": "markocupic/backend-password-recovery-bundle",
    "description": "Backend Password Recovery Plugin for Contao CMS",
    "keywords": [
        "contao",
        "backend",
        "password forgot",
        "password recovery"
    ],
    "type": "contao-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic/backend-password-recovery-bundle",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/backend-password-recovery-bundle/issues",
        "source": "https://github.com/markocupic/backend-password-recovery-bundle"
    },
    "require": {
        "php": "^8.4",
        "code4nix/uri-signer": "^1.0",
        "contao/core-bundle": "^5.3 || ^6.0",
        "ramsey/uuid": "^4.0",
        "scheb/2fa-bundle": "^6.0 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.1 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.1 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.13",
        "contao/test-case": "^5.3 || ^6.0"
    },
    "suggest": {
        "terminal42/notification_center": "Send the password recovery link via the Notification Center"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\BackendPasswordRecoveryBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markocupic\\BackendPasswordRecoveryBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\BackendPasswordRecoveryBundle\\ContaoManager\\Plugin"
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --fix --ansi",
        "cs-check": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --ansi",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": true
        }
    }
}
